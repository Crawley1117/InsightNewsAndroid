<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".ui.credibility.CredibilityFragment">

    <!-- 添加 Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- 内容展示区 (新闻和评估卡片) -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_chat"
        android:orientation="vertical"
        android:padding="16dp"
        android:maxHeight="400dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineInputArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"> <!-- 修正了顶部约束 -->

        <!-- 新闻卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/newsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/newsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重大发现！科学家在“蓝光-X”星球上发现高等文明痕迹！"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newsSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="fakenews.com"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 评估结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/assessmentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- 左侧文字区域 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新闻真实性评估"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/credibilityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="这篇新闻可信度 低"
                        android:textColor="@color/red"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/credibilityPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="可信度：10%"
                        android:textColor="@color/gray"
                        android:textSize="14sp" />

                    <!-- 评价按钮 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/likeButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/like"
                            android:src="@drawable/ic_good" />

                        <ImageButton
                            android:id="@+id/dislikeButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="16dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/dislike"
                            android:src="@drawable/ic_bad" />

                        <ImageButton
                            android:id="@+id/starButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="16dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/star"
                            android:src="@drawable/ic_star" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 右侧“低”字印章 -->
                <TextView
                    android:id="@+id/stampTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="16dp"
                    android:alpha="0.3"
                    android:text="低"
                    android:textColor="@color/red"
                    android:textSize="48sp" />

            </LinearLayout>

            <!-- “查看详细分析报告”按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="查看详细分析报告" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineInputArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.62" />

    <!-- 输入与操作区 (按钮区域) -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_hd"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineInputArea">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入你想检测的新闻"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:scrollbars="vertical" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_add"
            app:iconSize="24dp" />
    </LinearLayout>

    <!-- 功能快捷入口区 (2x2网格) -->
    <GridLayout
        android:id="@+id/functionGrid"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="16dp"
        android:alignmentMode="alignBounds"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_hd"
        app:layout_constraintTop_toBottomOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 图片按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/photoButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_photo"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 相机按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cameraButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_camera2"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 麦克风按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/microphoneButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_microphone2"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 文件夹按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_folder2"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>