<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.CredibilityFragment">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 占位符，用于让时钟图标靠右 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 时钟图标 -->
        <ImageButton
            android:id="@+id/clockButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clock"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clock" />
    </LinearLayout>

    <!-- 内容展示区 -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 新闻卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/newsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/newsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重大发现！科学家在“蓝光-X”星球上发现高等文明痕迹！"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/newsSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="fakenews.com"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 评估结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/assessmentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- 左侧文字区域 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新闻真实性评估"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/credibilityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="这篇新闻可信度 低"
                        android:textSize="16sp"
                        android:textColor="@color/red"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/credibilityPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="可信度：10%"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:layout_marginTop="4dp" />

                    <!-- 评价按钮 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <ImageButton
                            android:id="@+id/likeButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_like"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/like" />

                        <ImageButton
                            android:id="@+id/dislikeButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_dislike"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_marginStart="16dp"
                            android:contentDescription="@string/dislike" />

                        <ImageButton
                            android:id="@+id/starButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_star"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_marginStart="16dp"
                            android:contentDescription="@string/star" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 右侧“低”字印章 -->
                <TextView
                    android:id="@+id/stampTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="低"
                    android:textSize="48sp"
                    android:textColor="@color/red"
                    android:alpha="0.3"
                    android:layout_gravity="top"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

            <!-- “查看详细分析报告”按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看详细分析报告"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 输入与操作区 -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/functionGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入你想检测的新闻"
                android:inputType="textMultiLine"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:icon="@drawable/ic_add"
            app:iconSize="24dp" />
    </LinearLayout>

    <!-- 功能快捷入口区 (2x2网格) -->
    <GridLayout
        android:id="@+id/functionGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="16dp"
        android:alignmentMode="alignBounds"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 图片按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/photoButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_photo"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 相机按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cameraButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_camera"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 麦克风按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/microphoneButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_microphone"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />

        <!-- 文件夹按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:gravity="center"
            android:background="@drawable/button_rounded_outline"
            android:text=""
            app:icon="@drawable/ic_folder"
            app:iconSize="48dp"
            app:iconGravity="textStart"
            app:iconTint="@color/icon_tint" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>