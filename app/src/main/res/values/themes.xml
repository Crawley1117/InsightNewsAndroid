<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (带 ActionBar) -->
    <style name="Theme.InsightNewsAndroid" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 主色调：高级蓝色 -->
        <item name="colorPrimary">@color/blue_600</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 辅助色：可选的浅蓝色 -->
        <item name="colorSecondary">@color/blue_300</item>
        <item name="colorSecondaryVariant">@color/blue_400</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 应用背景 -->
        <item name="android:windowBackground">@drawable/bg_loading</item>
    </style>

    <!-- ✅ 新增：用于 HistoryActivity 和 ReportDetailActivity 的无 ActionBar 主题 -->
    <style name="Theme.InsightNewsAndroid.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 继承相同的配色 -->
        <item name="colorPrimary">@color/blue_600</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue_300</item>
        <item name="colorSecondaryVariant">@color/blue_400</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

</resources>