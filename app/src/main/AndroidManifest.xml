<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许网络访问-->

    <!-- 新增拍照所需权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InsightNewsAndroid">

        <!-- 新增 FileProvider 用于拍照 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 新增：SplashActivity 作为启动页 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.InsightNewsAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WelcomeActivity：不再作为启动页，移除 intent-filter -->
        <activity
            android:name=".auth.WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name">
            <!-- 注意：这里没有 intent-filter -->
        </activity>

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- ReportDetailActivity -->
        <activity
            android:name=".ReportDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 登录页 -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <!-- 注册页 -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".EnhancedReportActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 编辑资料页面 -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <activity
            android:name=".ui.profile.NewsCollectionActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 收藏新闻搜索界面 -->
        <activity
            android:name=".ui.profile.NewsSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- 话题详情页 -->
        <activity
            android:name=".ui.detail.DetailTopicActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:screenOrientation="portrait" />

        <!-- 话题收藏界面 -->
        <activity
            android:name=".ui.profile.TopicCollectionActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>

</manifest>
