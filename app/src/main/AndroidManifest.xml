<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InsightNewsAndroid">

        <!-- 启动页 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.InsightNewsAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WelcomeActivity -->
        <activity
            android:name=".auth.WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- ReportDetailActivity -->
        <activity
            android:name=".ReportDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 登录注册 -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <!-- 修复：EnhancedReportActivity 只保留一次 -->
        <activity
            android:name=".EnhancedReportActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 个人资料相关 -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />
        <activity
            android:name=".ui.profile.NewsCollectionActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />
        <activity
            android:name=".ui.profile.NewsSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- 话题相关 -->
        <activity
            android:name=".ui.detail.DetailTopicActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.TopicCollectionActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>
</manifest>
