<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许网络访问-->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"

        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InsightNewsAndroid">

        <!-- 新增：SplashActivity 作为启动页 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.InsightNewsAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WelcomeActivity：不再作为启动页，移除 intent-filter -->
        <activity
            android:name=".auth.WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name">
            <!-- 注意：这里没有 intent-filter -->
        </activity>

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- ReportDetailActivity -->
        <activity
            android:name=".ReportDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />

        <!-- 登录页 -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <!-- 注册页 -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".EnhancedReportActivity"
            android:exported="false"
            android:theme="@style/Theme.InsightNewsAndroid.NoActionBar" />
    </application>

</manifest>